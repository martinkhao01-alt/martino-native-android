<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listeFragment">

    <fragment
        android:id="@+id/listeFragment"
        android:name="com.carnet.restaurants.ui.list.ListeFragment"
        android:label="Mes Restaurants">
        <action
            android:id="@+id/action_liste_to_detail"
            app:destination="@id/detailFragment"/>
        <action
            android:id="@+id/action_liste_to_form"
            app:destination="@id/formFragment"/>
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.carnet.restaurants.ui.detail.DetailFragment"
        android:label="Détail">
        <argument
            android:name="restaurantId"
            app:argType="long"/>
        <action
            android:id="@+id/action_detail_to_form"
            app:destination="@id/formFragment"/>
    </fragment>

    <fragment
        android:id="@+id/formFragment"
        android:name="com.carnet.restaurants.ui.form.FormFragment"
        android:label="Restaurant">
        <argument
            android:name="restaurantId"
            app:argType="long"
            android:defaultValue="0"/>
        <action
            android:id="@+id/action_form_to_detail"
            app:destination="@id/detailFragment"
            app:popUpTo="@id/listeFragment"/>
    </fragment>

</navigation>
